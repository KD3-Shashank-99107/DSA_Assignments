public class Que3 {
	
	static int FFNRE(int[] arr) {
		
		for(int i =0;i<arr.length;i++) {
			boolean flag = false;
			for(int j = i;j<arr.length;j++) {
//				if(j == i) {
//					flag = true;
//				}
				if(arr[i] == arr[j]) {
					flag = true;
				}
			}
			if(flag == false) {
				return arr[i];
			}
		}
		return -1;
	}
	
 public static void main(String[] args) {
	 int[] arr = { 1, 2, 3, -1, 2, 1, 0, 4, -1, 7, 8 };
	 System.out.println(FFNRE(arr)); 
 }
}
