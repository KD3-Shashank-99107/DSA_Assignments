
public class Que4 {
	public static int findIndexOfLastOccurence(int[] arr , int key) {
		for(int i = arr.length - 1;i>=0;i--) {
			if(arr[i] == key) {
				return i;
			}
		}
		return -1;
	}
	public static void main(String[] args) {
		int[] arr = {10, 20, 30, 20, 40, 20, 50};
		int key = 20;
		
	  System.out.println(findIndexOfLastOccurence(arr , key));	
	}
}
