//{ 1, 2, 3, -1, 2, 1, 0, 4, -1, 7, 8 
public class Que3 {
	
	static int FFNRE(int[] arr) {
		boolean flag = false;
		for(int i =0;i<arr.length;i++) {
			for(int j = i+1;j<arr.length;j++) {
				
				if(arr[i] == arr[j]) {
					flag = true;
				}
			}
			if(flag == false) {
				return arr[i];
			}
		}
		return -1;
	}
 public static void main(String[] args) {
	 int[] arr = { 1, 2, 3, -1, 2, 1, 0, 4, -1, 7, 8 };
	System.out.println(FFNRE(arr)); 
 }
}
