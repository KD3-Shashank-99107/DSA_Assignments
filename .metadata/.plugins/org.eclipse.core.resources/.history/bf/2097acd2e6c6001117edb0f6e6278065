import java.util.LinkedList;
import java.util.Queue;
import java.util.Stack;

public class BST {
	static class Node {
		private int data;
		private Node left;
		private Node right;

		public Node(int data) {
			this.data = data;
		}

		public int getData() {
			return data;
		}

		public void setData(int data) {
			this.data = data;
		}

		public Node getLeft() {
			return left;
		}

		public void setLeft(Node left) {
			this.left = left;
		}

		public Node getRight() {
			return right;
		}

		public void setRight(Node right) {
			this.right = right;
		}

	}

	private Node root;

	public BST() {
		root = null;
	}

	public boolean isEmpty() {
		return root == null;
	}

	public void addData(int value) {
		Node newNode = new Node(value);

		if (root == null) {
			root = newNode;
		} else {
			Node trav = root;
			while (true) {
				if (trav.data > value) {
					if (trav.left == null) {
						trav.left = newNode;
						break;
					} else {
						trav = trav.left;
					}
				} else {
					if (trav.right == null) {
						trav.right = newNode;
						break;
					} else {
						trav = trav.right;
					}
				}
			}
		}
	}

	private void preOrder(Node trav) {
		if (trav == null) {
			return;
		}
		System.out.print(" " + trav.data);
		preOrder(trav.left);
		preOrder(trav.right);
	}

	public void preOrder() {
		System.out.print("PreOrder print : ");
		preOrder(root);
		System.out.println();
	}

	private void inOrder(Node trav) {
		if (trav == null) {
			return;
		}
		inOrder(trav.left);
		System.out.print(" " + trav.data);
		inOrder(trav.right);
	}

	public void inOrder() {
		System.out.print("inOrder print : ");
		inOrder(root);
		System.out.println();
	}

	private void postOrder(Node trav) {
		if (trav == null) {
			return;
		}
		postOrder(trav.left);
		postOrder(trav.right);
		System.out.print(" " + trav.data);
	}

	public void postOrder() {
		System.out.print("postOrder print : ");
		postOrder(root);
		System.out.println();
	}

	public Node search(int key) {
		Node trav = root;
		while (trav != null) {
			if (trav.data == key) {
				return trav;
			} else {
				if (trav.data > key) {
					trav = trav.left;
				} else {
					trav = trav.right;
				}
			}
		}
		return null;
	}

	public void deleteData(int key) {
		Node trav = root, parent = null;
		while (trav != null) {
			if (trav.data == key) {
				break;
			}
			parent = trav;
			if (trav.data > key) {
				trav = trav.left;
			} else {
				trav = trav.right;
			}
		}
		if (trav == null) {
			return;
		}

		if (trav.left != null && trav.right != null) {
			Node preDe = trav.left;
			parent = trav;

			while (preDe.right != null) {
				parent = preDe;
				preDe = preDe.right;
			}

			trav.data = preDe.data;

			if (preDe == parent.left) {
				parent.left = preDe.left;
			} else if(preDe == parent.right){
				parent.right = preDe.left;
			}
		}

		if (trav.right == null) {
			if (trav == root) {
				root = trav.left;
			} else if (trav == parent.left) {
				parent.left = trav.left;
			} else if(trav == parent.right){
				parent.right = trav.left;
			}
		}

		if (trav.left == null) {
			if (trav == root) {
				root = trav.right;
			} else if (trav == parent.right) {
				parent.right = trav.right;
			} else if(trav == parent.right){
				parent.left = trav.right;
			}
		}
	}
	
	public void DFSTraversel() {
		Stack<Node> stack = new Stack<>();
		
		Node trav = root;
		stack.push(trav);
		System.out.print("DFS Traversel : ");
		while(!stack.isEmpty()) {
			trav = stack.pop();
			System.out.print(" " + trav.data);
			if(trav.left != null) {
				stack.push(trav.left);
			}
			if(trav.right != null) {
				stack.push(trav.right);
			}
		}
		System.out.println();
	}
	
	public void BFSTraversel() {
		Queue<Node> que = new LinkedList<>();
		
		Node trav = root;
		que.offer(trav);
		System.out.print("BFS Traversel : ");
		while(!que.isEmpty()) {
			trav = que.poll();
			System.out.print(" " + trav.data);
			if(trav.left != null) {
				que.offer(trav.left);
			}
			if(trav.right != null) {
				que.offer(trav.right);
			}
		}
	}
	
	
     public int height(Node trav) {
    	 if(trav == null) {
    		 return -1;
    	 }
    	 
    	 int hl = height(trav.left);
    	 
    	 int hr = height(trav.right);
    	 
    	 int max = hl>hr ? hl : hr;
    	 return max +1;
     }
}





