
public class Que6 {
	public static int nthOccurenceOfFabbonacci(int n) {
		int i = 0;
		int j = 1;
		int c = 0;
		int count = 0;
		if(n == 0) {
			return 0;
		} else if (n == 1) {
			return 1;
		} else {
			while(count != n) {
				count++;
				c = i + j;
				i = j;
				j = c;
			}
		}
		return c;
	}
	public static void main(String[] args) {
	System.out.println(nthOccurenceOfFabbonacci(5));	
	}
}
