public class QueueUsingCounter {
	private final int size;
	private int[] arr;
	private int rear;
	private int front;
	private int count;

	public QueueUsingCounter(int size) {
		this.size = size;
		arr = new int[size];
		front = rear = -1;
		count = 0;
	}

	public void offer(int value) {
		if (isFull()) {
			System.out.println("Stack is full");
		} else {
			rear = (rear + 1) % size;
			arr[rear] = value;
			count++;
		}
	}

	public int poll() {
		int temp = -1;
		if(isEmpty()) {
			System.out.println("Stack is empty");
		} else {
			temp = arr[(front + 1) % size];
			front++;
			count--;
		}
		
		return temp;
	}

	public int peek() {
		int temp = -1;
		if(isEmpty()) {
			System.out.println("Stack is empty");
		} else {
			temp = arr[(front + 1) % size];
		}
		
		return temp;
	}

	public boolean isEmpty() {
		return count == 0;
	}

	public boolean isFull() {
		return count == size;
	}

}
