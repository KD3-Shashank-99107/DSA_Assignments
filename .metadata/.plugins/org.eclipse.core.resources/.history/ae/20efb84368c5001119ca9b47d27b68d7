public class LinkedList {
	static class Node{
		private Employee emp;
		private Node next;
		private Node prev;
		
		public Node(Employee emp) {
			this.emp = emp;
			next = prev = null;
		}
	}
	
	private Node head;
	private int size;
	
	public LinkedList() {
		head = null;
	}
	
	public boolean isEmpty() {
		return head == null;
	}

	public void addFirst(Employee emp) {
		Node newNode = new Node(emp);
		if(isEmpty()) {
			head = newNode;
		} else {
			newNode.next = head;
			head.prev= newNode;
			head = newNode;
		}
	}

	public void addLast(Employee emp) {
		Node newNode = new Node(emp);
		if(isEmpty()) {
			head = newNode;
		} else {
			Node trav = head;
			while(trav.next != null) {
				trav = trav.next;
			}
			newNode.prev = trav;
			trav.next = newNode;
		}
	}

	public void searchEmployee(int empId) {
		if(isEmpty()) {
			System.out.println("Employee does not exist");
		} else {
			Node trav = head;
			while(trav != null) {
				if(trav.emp.getEmpid() == empId) {
					System.out.println(trav.emp.toString());
				}
				trav = trav.next;
			}
		}
	}

	public void deleteEmployee(int empId) {
		if(isEmpty()) {
			System.out.println("Employee does not exist");
		} else {
			if(head.emp.getEmpid() == empId) {
				head = head.next;
			} else {
				Node trav = head.next;
				while(trav != null) {
					if(trav.emp.getEmpid() == empId) {
						trav.prev.next =  trav.next;
						trav.next.prev = trav.prev;
					}
					trav = trav.next;
				}
			}
		}
	}

	public void displayFirst() {
		if(isEmpty()) {
			System.out.println("List is empty");
		} else {
			Node trav = head;
			System.out.println("==========================");
			while(trav != null) {
				System.out.println(trav.emp.toString());
				trav = trav.next;
			}
			System.out.println("==========================");
		}
	}


